{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanban-mvp.local/schemas/kanban-board.schema.json",
  "title": "Kanban MVP board data",
  "description": "JSON representation of users and each user's single Kanban board.",
  "type": "object",
  "required": ["users"],
  "additionalProperties": false,
  "properties": {
    "users": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/user" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "user": {
      "type": "object",
      "required": ["id", "username", "board"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "username": { "type": "string", "minLength": 1 },
        "board": { "$ref": "#/$defs/board" }
      }
    },
    "board": {
      "type": "object",
      "required": ["id", "columns", "cards"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "columns": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/column" }
        },
        "cards": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/card" }
        }
      }
    },
    "column": {
      "type": "object",
      "required": ["id", "title", "cardIds"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1 },
        "cardIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "card": {
      "type": "object",
      "required": ["id", "title", "details"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1 },
        "details": { "type": "string" }
      }
    }
  }
}